+def split_reason_content(text: str):
+    # [patch 0005] format adapter for backbones without Qwen <think> tags
+    if '</think>' in text:
+        reason, _, content = text.rpartition('</think>')
+        reason = reason.split('<think>', 1)[-1].strip()
+        return reason, content.strip()
+    if '## Final Response' in text:
+        reason, _, content = text.partition('## Final Response')
+        reason = reason.replace('## Thinking', '', 1).strip()
+        return reason, content.strip()
+    return '', text.strip()
